# ============================================================
# base-agents stack config. Copy to .env:  cp .env.example .env
# Provider is a SINGLE FLIP — pick exactly one profile below.
# ============================================================

HEADROOM_MODE=token          # token = compress (RAG) | cache = protect prefix cache
HEADROOM_PORT=8787           # host port claude-cli points ANTHROPIC_BASE_URL at

# ---------- Profile A (DEFAULT): LiteLLM gateway (llm-gateway) ----------
# Anthropic-compatible. claude-cli's own token from ~/.claude/settings.json
# passes straight through the proxy — nothing secret to set here.
HEADROOM_BACKEND=anthropic
ANTHROPIC_TARGET_API_URL=https://llm-gateway.example.internal

# ---------- Profile B: OpenRouter (flip to this later) ----------
# HEADROOM_BACKEND=openrouter
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx
# NOTE: on the HOST, also `export ANTHROPIC_API_KEY=sk-ant-dummy` so claude-cli
#       (Anthropic wire format) is satisfied; the real key above is used upstream.

# ---------- Profile C: local Ollama (host app, Metal) ----------
# HEADROOM_BACKEND=anyllm
# HEADROOM_ANYLLM_PROVIDER=ollama
# OPENAI_TARGET_API_URL=http://host.docker.internal:11434/v1
